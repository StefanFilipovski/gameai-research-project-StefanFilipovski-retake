# ==============================================================
# Unity .gitignore  (generated from gitignore.io "Unity" template)
# Only source, scenes, prefabs and settings are tracked. Everything
# Unity regenerates on import is ignored.
# ==============================================================

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated VS/Rider/MonoDevelop solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Gradle cache
.gradle/

# JetBrains Rider
.idea/

# Visual Studio cache
.vs/

# OS files
.DS_Store
Thumbs.db
desktop.ini
